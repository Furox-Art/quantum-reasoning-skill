#!/usr/bin/env python3
"""Checkout launcher for the ``quantum-reasoning`` console script.

The CLI implementation lives in the importable package at
``quantum_reasoning_skill/cli.py`` so that it ships in the wheel and is exercised
by the package's own tests. This file only makes the command runnable from a
source checkout, where the package is not installed.
"""

from __future__ import annotations

import sys
from pathlib import Path

if __package__ in (None, ""):
    sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from quantum_reasoning_skill.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
